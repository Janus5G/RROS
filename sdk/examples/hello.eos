; Prints "Hello" and a newline, then the sum 1..100.
        push 72
        putc
        push 101
        putc
        push 108
        putc
        push 108
        putc
        push 111
        putc
        push 10
        putc
        push 0
        store 0         ; sum
        push 1
        store 1         ; n
again:  load 1
        push 101
        lt
        jz out
        load 0
        load 1
        add
        store 0
        load 1
        push 1
        add
        store 1
        jmp again
out:    load 0
        print
        halt
